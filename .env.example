# Copy this file to .env and add the provider credentials you use.
SARAH_GEMINI_MODEL=gemini-3.8-flash
SARAH_LLM_TIMEOUT_SECONDS=45
GEMINI_API_KEY=your-gemini-api-key-here
HUGGINGFACE_API_KEY=
